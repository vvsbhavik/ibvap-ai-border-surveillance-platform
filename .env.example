# ============================================================================
# IBVAP Environment Configuration
# Operating Profiles: DEMO (default in-memory) | PRODUCTION (enforces external services)
# ============================================================================

# Platform Operating Profile
APP_PROFILE=DEMO
PORT=3000

# Persistent Relational Database (PostgreSQL / Supabase)
# Required in PRODUCTION mode; optional in DEMO mode
DATABASE_URL=postgres://ibvap_admin:ibvap_secure_pass@localhost:5432/ibvap_core

# Supabase Database & Auth Integration
# Configure with your Supabase Project settings (https://supabase.com)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Fast Realtime Cache & Event Broker (Redis)
# Optional in DEMO mode (uses in-memory fallback)
REDIS_URL=redis://localhost:6379/0

# Cryptographic & Session Secrets
JWT_SECRET=ibvap-mission-critical-token-secret-2026

# Google Gemini Generative AI Key (Server-Side Only)
GEMINI_API_KEY=

# Evidence Vault Configuration
EVIDENCE_STORAGE_TYPE=LOCAL
EVIDENCE_STORAGE_PATH=./storage/evidence
MAX_EVIDENCE_SIZE_BYTES=26214400

# Retention Policies (in Hours)
RETENTION_EVENTS_HOURS=168
RETENTION_ALERTS_HOURS=720
RETENTION_INCIDENTS_HOURS=2160
RETENTION_AUDIT_HOURS=8760
RETENTION_EVIDENCE_HOURS=4320
RETENTION_RECORDS_HOURS=336
